# 仕様: docs/spec/framework.md#1.4, docs/spec/framework_llm.md#6.3
# コピー: cp .env.example .env のあと、.env に実値を記入する（.env はコミットしない）

# Phase 1c — ライブ音声認識。未設定時は internal POST のみ
# 仕様: docs/spec/framework_amivoice.md#4.1
AMIVOICE_API_KEY=
# 省略可: AMIVOICE_WS_URL=wss://acp-api.amivoice.com/v1/
# 省略可: AMIVOICE_GRAMMAR_FILE_NAMES=-a2-ja-general
# 省略可: AMIVOICE_RECEIVE_TIMEOUT_MS=0  # 0 は受信タイムアウト無効
# 省略可: AUDIO_CAPTURE_DEVICE=VB-Cable（Windows は CABLE Output 等）

AMIVOICE_SPEAKER_DISPLAY_NAME=
AMIVOICE_PROXY_SERVER_NAME=

# Phase 3 — LLMのAPIキー
LLM_API_KEY=

# デバッグ: AmiVoice 経路の DEBUG ログ（秘密情報は出さない）
AMIVOICE_DEBUG=1
# LOG_LEVEL=DEBUG

# 省略可（framework/settings.py の既定値を使用）
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_RPM_LIMIT=15
# LLM_RPD_LIMIT=500
# HOST=127.0.0.1
# PORT=8000
